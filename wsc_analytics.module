<?php

/**
 * @file
 * Primary module hooks for WSC Analytics & Search Health (v2.2.3).
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Url;

/**
 * Implements hook_page_attachments().
 */
function wsc_analytics_page_attachments(array &$page) {
  $config = \Drupal::config('wsc_analytics.settings');

  if (!$config->get('tracking_active')) {
    return;
  }

  $current_user = \Drupal::currentUser();
  if ($config->get('exclude_admins') && $current_user->hasPermission('administer wsc analytics')) {
    return;
  }

  $page['#attached']['library'][] = 'wsc_analytics/tracker';
  $page['#attached']['drupalSettings']['wscConfig'] = [
    'endpoint'   => Url::fromRoute('wsc_analytics.api_track')->toString(),
    'mode'       => $config->get('tracking_mode') ?: 'cookieless',
    'consentKey' => 'wsc_consent',
    'version'    => '2.2.3',
    'auto'       => [
      'downloads'         => (bool) $config->get('auto_downloads'),
      'media'             => (bool) $config->get('auto_media'),
      'outbound'          => (bool) $config->get('auto_outbound'),
      'forms'             => (bool) $config->get('auto_forms'),
      'scroll'            => (bool) $config->get('auto_scroll'),
      'timeOnPage'        => (bool) $config->get('auto_time_on_page'),
      'timeToInteraction' => (bool) $config->get('auto_time_to_interaction'),
      'videoProgress'     => (bool) $config->get('auto_video_progress'),
      'formFieldTiming'   => (bool) $config->get('auto_form_field_timing'),
    ],
  ];
}

/**
 * Implements hook_entity_insert() for Opt-In IndexNow node notifications & Drupal Commerce orders.
 */
function wsc_analytics_entity_insert(EntityInterface $entity) {
  _wsc_analytics_handle_entity_save($entity);
}

/**
 * Implements hook_entity_update() for Opt-In IndexNow node notifications.
 */
function wsc_analytics_entity_update(EntityInterface $entity) {
  _wsc_analytics_handle_entity_save($entity);
}

/**
 * Internal helper to handle published Node IndexNow push & Commerce order conversion tracking.
 */
function _wsc_analytics_handle_entity_save(EntityInterface $entity): void {
  try {
    /** @var \Drupal\wsc_analytics\Service\WscCoreService $core */
    $core = \Drupal::service('wsc_analytics.core');
    $type = $entity->getEntityTypeId();

    if ($type === 'node' && method_exists($entity, 'isPublished') && $entity->isPublished()) {
      $config = \Drupal::config('wsc_analytics.settings');
      if ($config->get('indexnow_enabled')) {
        $url = $entity->toUrl('canonical', ['absolute' => true])->toString();
        $home = rtrim(\Drupal::request()->getSchemeAndHttpHost(), '/') . '/';
        $core->submitIndexNow([$url, $home], 'auto');
      }
    }
    elseif ($type === 'commerce_order' && method_exists($entity, 'getState')) {
      $state_id = $entity->getState()->getId();
      if (in_array($state_id, ['completed', 'fulfillment'], true)) {
        $total = method_exists($entity, 'getTotalPrice') && $entity->getTotalPrice() ? $entity->getTotalPrice()->getNumber() : 0;
        $currency = method_exists($entity, 'getTotalPrice') && $entity->getTotalPrice() ? $entity->getTotalPrice()->getCurrencyCode() : 'EUR';
        $core->trackEvent('purchase', '/checkout/complete', '', [
          'order_id' => (string) $entity->id(),
          'total'    => (float) $total,
          'currency' => (string) $currency,
        ]);
      }
    }
  }
  catch (\Throwable $e) {
    // Non-blocking entity hook
  }
}

/**
 * Implements hook_cron().
 */
function wsc_analytics_cron() {
  /** @var \Drupal\wsc_analytics\Service\WscCoreService $core */
  $core = \Drupal::service('wsc_analytics.core');
  $core->processBatchExport();

  $last_cleanup = \Drupal::state()->get('wsc_analytics.last_cleanup', 0);
  if ((time() - $last_cleanup) > 86400) {
    $core->cleanupOldData();
    \Drupal::state()->set('wsc_analytics.last_cleanup', time());
  }
}

/**
 * Implements hook_theme().
 */
function wsc_analytics_theme() {
  return [
    'wsc_dashboard' => [
      'variables' => [
        'card1'             => [],
        'card2'             => [],
        'card3'             => [],
        'card_engagement'   => [],
        'card_outbound'     => [],
        'card_ecommerce'    => [],
        'domain_health'     => [],
        'pagespeed'         => [],
        'membership'        => [],
        'benchmarks'        => [],
        'featured_partners' => [],
        'indexnow_logs'     => [],
        'llms_txt_enabled'  => true,
        'indexnow_enabled'  => false,
        'indexnow_key'      => '',
        'project_id'        => '',
        'last_sync'         => '',
        'has_data'          => false,
        'site_host'         => '',
        'site_url'          => '',
      ],
      'template' => 'wsc-dashboard',
    ],
  ];
}
